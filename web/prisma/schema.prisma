generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("staff")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

model Client {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique
  plan          String    @default("sem_aprovacao")
  toneOfVoice   String?   @map("tone_of_voice")
  // override opcional: ID da pasta do cliente no Drive. Se vazio, busca pelo nome.
  driveFolderId String?   @map("drive_folder_id")
  // --- dados de onboarding (substitui o doc por cliente) ---
  tradeName     String?   @map("trade_name")     // nome fantasia
  website       String?
  city          String?                          // cidade - UF
  phone         String?                          // fixo
  whatsapp      String?
  facebookUrl   String?   @map("facebook_url")
  instagramUrl  String?   @map("instagram_url")
  // diretrizes de conteúdo (temas, hashtags, restrições, texto obrigatório nas artes, etc.)
  briefing      Json?
  // credenciais por rede (login/senha) — JSON CRIPTOGRAFADO (AES-GCM). Nunca em texto plano.
  credentialsEnc String?  @map("credentials_enc")
  // marca (p/ geração de arte por IA em clientes de gestão básica)
  logoUrl       String?   @map("logo_url")
  brandColor    String?   @map("brand_color") // hex, ex: #7c5cff
  tier          String    @default("completa") // basica | completa
  // exibir dados de contato (phone/whatsapp/site/instagram) na arte gerada?
  showContacts  Boolean   @default(false) @map("show_contacts")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  socialAccounts SocialAccount[]
  schedules      Schedule[]
  posts          Post[]

  @@map("clients")
}

model SocialAccount {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  platform       String
  externalId     String    @map("external_id")
  accessTokenEnc String    @map("access_token_enc")
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(6)
  // refresh token (LinkedIn OAuth — Meta usa token de longa duração sem refresh)
  refreshTokenEnc       String?   @map("refresh_token_enc")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  dailyPostLimit Int       @default(25) @map("daily_post_limit")
  status         String    @default("active")
  // de qual conexão Meta esta conta foi importada (se aplicável)
  metaConnectionId String? @map("meta_connection_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metaConnection MetaConnection? @relation(fields: [metaConnectionId], references: [id], onDelete: SetNull)

  @@index([clientId], map: "idx_accounts_client")
  @@index([tokenExpiresAt], map: "idx_tokens_expiring")
  @@map("social_accounts")
}

model MetaConnection {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  businessId     String?  @map("business_id")
  accessTokenEnc String   @map("access_token_enc") // System User token (criptografado)
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  socialAccounts SocialAccount[]

  @@map("meta_connections")
}

model Schedule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  monthRef  DateTime @map("month_ref") @db.Date
  // rascunho | aprovado_interno | enviado_cliente | em_revisao | aprovado_cliente
  status    String   @default("rascunho")
  approvalToken String?   @unique @map("approval_token") // link público de aprovação
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts  Post[]

  @@map("schedules")
}

model Post {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId  String?   @map("schedule_id") @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  theme       String?
  caption     String?
  captions    Json?     // legenda por rede: { instagram?, facebook?, linkedin? }
  mediaUrl    String?   @map("media_url")
  mediaDriveId String?  @map("media_drive_id") // ID do arquivo no Google Drive (origem da mídia)
  // itens do carrossel (ordenados): [{ url, driveId, type }]. Single fica em mediaUrl.
  mediaItems  Json?     @map("media_items")
  format      String    @default("feed") // feed | story | carrossel | reels
  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz(6)
  targets     String[]
  status      String    @default("scheduled")
  aiEditsUsed Int       @default(0) @map("ai_edits_used") // regenerações IA na aprovação (máx 5)
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error")
  // arte-base que originou este post (plano básico) — evita duplicar na regeração
  artTemplateId String? @map("art_template_id") @db.Uuid
  // "lembrança": miniatura (data URI jpeg ~15KB) gravada ao publicar; a mídia
  // cheia fica no R2 por 30 dias e depois é excluída (não ocupa Cloudflare)
  mediaThumb  String?   @map("media_thumb")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  schedule     Schedule?     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  publications Publication[]

  @@index([scheduledAt], map: "idx_posts_due")
  @@map("posts")
}

model Publication {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  platform       String
  externalPostId String?   @map("external_post_id")
  status         String    @default("pending")
  error          String?
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("publications")
}

// Arte-base para geração por IA (gestão básica). Versionada por período;
// a IA edita esta imagem aplicando cor/logo/tema do cliente.
model ArtTemplate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   // título da arte (tema da postagem)
  month        String?  // "YYYY-MM" (campanha do mês), opcional
  // agenda no calendário do plano básico (dia do mês + hora SP "HH:mm")
  day          Int?
  time         String?  @default("18:00")
  // legendas padronizadas (mesmas p/ todos os clientes básicos): { shared, linkedin }
  captions     Json?
  baseImageUrl String   @map("base_image_url")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("art_templates")
}

// Resumo diário gerado por IA para a dashboard (1 por dia, fuso SP).
model DailySummary {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day       String   @unique // "YYYY-MM-DD" no fuso America/Sao_Paulo
  content   String
  postCount Int      @default(0) @map("post_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("daily_summaries")
}
