# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/socialflow"

# Criptografia de tokens OAuth
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY="64_hex_chars_aqui"

# Chave compartilhada entre o sistema e o n8n para o endpoint interno
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY="chave_secreta_compartilhada_com_n8n"

# Meta (Facebook / Instagram)
META_APP_ID="seu_app_id"
META_APP_SECRET="seu_app_secret"

# NextAuth
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="gere_com_openssl_rand_base64_32"
AUTH_URL="http://localhost:3000"

# Gemini (IA)
GEMINI_API_KEY="sua_chave_gemini"
GEMINI_CAPTION_MODEL="gemini-2.5-flash"
GEMINI_CALENDAR_MODEL="gemini-3.5-flash"

# Google Drive (service account)
# Opção 1 — Produção/Vercel: cole o JSON inteiro da service account como string
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# Opção 2 — Dev local: caminho relativo ao cwd para o arquivo .json (gitignored)
GOOGLE_SERVICE_ACCOUNT_FILE="../secrets/google-service-account.json"
DRIVE_ROOT_FOLDER_ID="id_da_pasta_raiz_no_drive"

# Assinatura HMAC das URLs de mídia servidas ao Graph API
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIA_SIGNING_SECRET="64_hex_chars_aqui"

# URL pública do sistema (túnel/deploy), sem barra no final
SYSTEM_BASE_URL="http://localhost:3000"

# LinkedIn
LINKEDIN_CLIENT_ID="seu_client_id"
LINKEDIN_CLIENT_SECRET="seu_client_secret"

# Resend (e-mail de aprovacao do cronograma)
RESEND_API_KEY=""
RESEND_FROM="no-reply@seudominio.com.br"
