{
  "name": "WF-01 Publish Multi-Rede (escalavel, fila Postgres)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      },
      "id": "schedule",
      "name": "Schedule (a cada 5min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE posts SET status='publishing' WHERE id IN (SELECT id FROM posts WHERE status='scheduled' AND scheduled_at <= now() ORDER BY scheduled_at LIMIT 10) RETURNING id, client_id, caption, media_url, targets, scheduled_at;",
        "options": {}
      },
      "id": "busca-fila",
      "name": "Busca fila (lock)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [20, 400],
      "notes": "Lock otimista: marca como 'publishing' antes de retornar. Evita processar o mesmo post duas vezes no caso de execucoes sobrepostas. LIMIT 10 = tamanho do lote."
    },
    {
      "parameters": {
        "options": { "reset": false }
      },
      "id": "split",
      "name": "Split in Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [240, 400],
      "notes": "Processa 1 post por vez para controlar rate limit."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SYSTEM_BASE_URL }}/api/internal/accounts/{{ $json.client_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-key", "value": "={{ $env.INTERNAL_API_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "busca-contas",
      "name": "Busca contas do cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 400],
      "notes": "GET /api/internal/accounts/{client_id} — retorna array de { id, platform, externalId, token, dailyPostLimit }. Token ja vem descriptografado pelo sistema."
    },
    {
      "parameters": {
        "jsCode": "// Monta os campos por plataforma no item do post\nconst post = $('Split in Batches').item.json;\nconst accounts = $input.all().map(i => i.json);\n\nconst ig = accounts.find(a => a.platform === 'instagram');\nconst fb = accounts.find(a => a.platform === 'facebook');\nconst li = accounts.find(a => a.platform === 'linkedin');\n\nreturn [{\n  json: {\n    ...post,\n    ig_user_id:  ig?.externalId ?? null,\n    ig_token:    ig?.token      ?? null,\n    page_id:     fb?.externalId ?? null,\n    fb_token:    fb?.token      ?? null,\n    li_org_id:   li?.externalId ?? null,\n    li_token:    li?.token      ?? null,\n  }\n}];"
      },
      "id": "monta-campos",
      "name": "Monta campos por rede",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 400],
      "notes": "Agrega as contas retornadas pelo sistema e injeta ig_user_id/ig_token/page_id/fb_token/li_token no item do post para os branches downstream."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.ig_user_id }}/content_publishing_limit",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "fields", "value": "quota_usage,config" },
            { "name": "access_token", "value": "={{ $json.ig_token }}" }
          ]
        },
        "options": {}
      },
      "id": "rate-check",
      "name": "Checa rate limit IG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 400],
      "notes": "Verifica quota_usage antes de publicar. Se quota_usage >= daily_post_limit da conta, o post deve ser reagendado. A resposta e usada no no IF abaixo."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "quota",
              "leftValue": "={{ $json.data[0].quota_usage }}",
              "rightValue": "={{ $('Monta campos por rede').item.json.daily_post_limit ?? 25 }}",
              "operator": { "type": "number", "operation": "lt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "quota-ok",
      "name": "Quota disponivel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 400],
      "notes": "Verdadeiro: segue para publicacao. Falso: adia o post para amanha."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE posts SET status='scheduled', scheduled_at = now() + interval '24 hours', last_error='rate_limit' WHERE id='{{ $('Monta campos por rede').item.json.id }}';",
        "options": {}
      },
      "id": "adia-rate-limit",
      "name": "Adia por rate limit",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1340, 600],
      "notes": "Reagenda para 24h depois sem incrementar retry_count (rate limit nao e falha de API)."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "version": 2 },
                "conditions": [
                  {
                    "id": "ig",
                    "leftValue": "={{ $json.targets }}",
                    "rightValue": "instagram",
                    "operator": { "type": "array", "operation": "contains", "rightType": "any" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "instagram"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "version": 2 },
                "conditions": [
                  {
                    "id": "fb",
                    "leftValue": "={{ $json.targets }}",
                    "rightValue": "facebook",
                    "operator": { "type": "array", "operation": "contains", "rightType": "any" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "facebook"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "version": 2 },
                "conditions": [
                  {
                    "id": "li",
                    "leftValue": "={{ $json.targets }}",
                    "rightValue": "linkedin",
                    "operator": { "type": "array", "operation": "contains", "rightType": "any" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "linkedin"
            }
          ]
        },
        "options": { "allMatchingOutputs": true }
      },
      "id": "switch-targets",
      "name": "Switch targets",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1340, 400],
      "notes": "allMatchingOutputs=true: o mesmo post pode sair em IG E FB ao mesmo tempo. LinkedIn so e acionado quando 'linkedin' estiver em targets."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Monta campos por rede').item.json.ig_user_id }}/media",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "image_url", "value": "={{ $('Monta campos por rede').item.json.media_url }}" },
            { "name": "caption", "value": "={{ $('Monta campos por rede').item.json.caption }}" },
            { "name": "access_token", "value": "={{ $('Monta campos por rede').item.json.ig_token }}" }
          ]
        },
        "options": {}
      },
      "id": "ig-container",
      "name": "IG: Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 200],
      "notes": "Cria container de midia. Para REELS: troque image_url por video_url e adicione media_type=REELS."
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "ig-wait",
      "name": "IG: Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1780, 200],
      "webhookId": "ig-wait-hook",
      "notes": "Para imagem basta 5s. Para video, implemente o loop de polling do WF-01-instagram-publish.json."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/{{ $('IG: Container').item.json.id }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "fields", "value": "status_code" },
            { "name": "access_token", "value": "={{ $('Monta campos por rede').item.json.ig_token }}" }
          ]
        },
        "options": {}
      },
      "id": "ig-check",
      "name": "IG: Checa status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "fin",
              "leftValue": "={{ $json.status_code }}",
              "rightValue": "FINISHED",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ig-finished",
      "name": "IG: FINISHED?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2220, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Monta campos por rede').item.json.ig_user_id }}/media_publish",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "creation_id", "value": "={{ $('IG: Container').item.json.id }}" },
            { "name": "access_token", "value": "={{ $('Monta campos por rede').item.json.ig_token }}" }
          ]
        },
        "options": {}
      },
      "id": "ig-publish",
      "name": "IG: Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2440, 100]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO publications (post_id, platform, external_post_id, status, published_at) VALUES ('{{ $('Monta campos por rede').item.json.id }}', 'instagram', '{{ $json.id }}', 'success', now());",
        "options": {}
      },
      "id": "ig-pub-ok",
      "name": "IG: Grava publication",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [2660, 100]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO publications (post_id, platform, status, error) VALUES ('{{ $('Monta campos por rede').item.json.id }}', 'instagram', 'failed', '{{ $json.message ?? $json.error ?? \"unknown\" }}');  UPDATE posts SET status='failed', retry_count=retry_count+1, last_error='instagram: ' || '{{ $json.message ?? $json.error ?? \"unknown\" }}' WHERE id='{{ $('Monta campos por rede').item.json.id }}';",
        "options": {}
      },
      "id": "ig-pub-fail",
      "name": "IG: Marca failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [2440, 320],
      "notes": "Conecte a saida de erro do IG: Publish e IG: Container aqui via Error output."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Monta campos por rede').item.json.page_id }}/photos",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "url", "value": "={{ $('Monta campos por rede').item.json.media_url }}" },
            { "name": "caption", "value": "={{ $('Monta campos por rede').item.json.caption }}" },
            { "name": "access_token", "value": "={{ $('Monta campos por rede').item.json.fb_token }}" }
          ]
        },
        "options": {}
      },
      "id": "fb-publish",
      "name": "FB: Publish foto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 400],
      "notes": "Para video: use /{page_id}/videos. Para texto puro: /{page_id}/feed."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO publications (post_id, platform, external_post_id, status, published_at) VALUES ('{{ $('Monta campos por rede').item.json.id }}', 'facebook', '{{ $json.id }}', 'success', now());",
        "options": {}
      },
      "id": "fb-pub-ok",
      "name": "FB: Grava publication",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1780, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO publications (post_id, platform, status, error) VALUES ('{{ $('Monta campos por rede').item.json.id }}', 'facebook', 'failed', '{{ $json.message ?? $json.error ?? \"unknown\" }}');  UPDATE posts SET status='failed', retry_count=retry_count+1, last_error='facebook: ' || '{{ $json.message ?? $json.error ?? \"unknown\" }}' WHERE id='{{ $('Monta campos por rede').item.json.id }}';",
        "options": {}
      },
      "id": "fb-pub-fail",
      "name": "FB: Marca failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1780, 560],
      "notes": "Conecte a saida de erro do FB: Publish aqui via Error output."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Monta campos por rede').item.json.li_token }}" },
            { "name": "LinkedIn-Version", "value": "202401" },
            { "name": "X-Restli-Protocol-Version", "value": "2.0.0" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"author\": \"urn:li:organization:{{ $('Monta campos por rede').item.json.li_org_id }}\",\n  \"commentary\": {{ JSON.stringify($('Monta campos por rede').item.json.caption) }},\n  \"visibility\": \"PUBLIC\",\n  \"distribution\": { \"feedDistribution\": \"MAIN_FEED\", \"targetEntities\": [], \"thirdPartyDistributionChannels\": [] },\n  \"lifecycleState\": \"PUBLISHED\"\n}",
        "options": {}
      },
      "id": "li-publish",
      "name": "LinkedIn: Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 600],
      "notes": "FASE 1.5 — manter desligado ate App Review aprovado. Post com imagem exige registro de asset antes (fluxo extra)."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO publications (post_id, platform, external_post_id, status, published_at) VALUES ('{{ $('Monta campos por rede').item.json.id }}', 'linkedin', '{{ $json.id }}', 'success', now());",
        "options": {}
      },
      "id": "li-pub-ok",
      "name": "LinkedIn: Grava publication",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1780, 600]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE posts SET status='published' WHERE id='{{ $('Monta campos por rede').item.json.id }}' AND NOT EXISTS (SELECT 1 FROM publications WHERE post_id='{{ $('Monta campos por rede').item.json.id }}' AND status='failed');",
        "options": {}
      },
      "id": "marca-published",
      "name": "Marca published",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [2000, 400],
      "notes": "Marca published apenas se nenhuma publicacao falhou. Se algum branch falhou, o status ja foi setado para 'failed' pelo no de erro daquele branch."
    }
  ],
  "connections": {
    "Schedule (a cada 5min)": {
      "main": [[{ "node": "Busca fila (lock)", "type": "main", "index": 0 }]]
    },
    "Busca fila (lock)": {
      "main": [[{ "node": "Split in Batches", "type": "main", "index": 0 }]]
    },
    "Split in Batches": {
      "main": [[{ "node": "Busca contas do cliente", "type": "main", "index": 0 }]]
    },
    "Busca contas do cliente": {
      "main": [[{ "node": "Monta campos por rede", "type": "main", "index": 0 }]]
    },
    "Monta campos por rede": {
      "main": [[{ "node": "Checa rate limit IG", "type": "main", "index": 0 }]]
    },
    "Checa rate limit IG": {
      "main": [[{ "node": "Quota disponivel?", "type": "main", "index": 0 }]]
    },
    "Quota disponivel?": {
      "main": [
        [{ "node": "Switch targets", "type": "main", "index": 0 }],
        [{ "node": "Adia por rate limit", "type": "main", "index": 0 }]
      ]
    },
    "Switch targets": {
      "main": [
        [{ "node": "IG: Container", "type": "main", "index": 0 }],
        [{ "node": "FB: Publish foto", "type": "main", "index": 0 }],
        [{ "node": "LinkedIn: Publish", "type": "main", "index": 0 }]
      ]
    },
    "IG: Container": {
      "main": [[{ "node": "IG: Wait", "type": "main", "index": 0 }]]
    },
    "IG: Wait": {
      "main": [[{ "node": "IG: Checa status", "type": "main", "index": 0 }]]
    },
    "IG: Checa status": {
      "main": [[{ "node": "IG: FINISHED?", "type": "main", "index": 0 }]]
    },
    "IG: FINISHED?": {
      "main": [
        [{ "node": "IG: Publish", "type": "main", "index": 0 }],
        [{ "node": "IG: Wait", "type": "main", "index": 0 }]
      ]
    },
    "IG: Publish": {
      "main": [[{ "node": "IG: Grava publication", "type": "main", "index": 0 }]]
    },
    "IG: Grava publication": {
      "main": [[{ "node": "Marca published", "type": "main", "index": 0 }]]
    },
    "FB: Publish foto": {
      "main": [[{ "node": "FB: Grava publication", "type": "main", "index": 0 }]]
    },
    "FB: Grava publication": {
      "main": [[{ "node": "Marca published", "type": "main", "index": 0 }]]
    },
    "LinkedIn: Publish": {
      "main": [[{ "node": "LinkedIn: Grava publication", "type": "main", "index": 0 }]]
    },
    "LinkedIn: Grava publication": {
      "main": [[{ "node": "Marca published", "type": "main", "index": 0 }]]
    },
    "Marca published": {
      "main": [[{ "node": "Split in Batches", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
