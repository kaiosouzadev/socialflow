    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE posts SET status='publishing' WHERE id IN (SELECT id FROM posts WHERE status='scheduled' AND scheduled_at <= now() ORDER BY scheduled_at LIMIT 10) RETURNING id",
        "options": {}
      },
      "id": "5806a1ce-a384-4361-934f-7d6cb4c75f01",
      "name": "Busca fila (lock)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-2240, 560],
      "credentials": { "postgres": { "id": "zIPyAquVv49cM1kf", "name": "Postgres SocialFlow" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "369bd175-d5f2-4dd6-8e29-55216bcfe32f",
      "name": "Tem post?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [-2016, 560]
    },
    {
      "parameters": { "options": {} },
      "id": "cc046636-8258-4676-960d-f7b43804d9c9",
      "name": "Loop posts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-1792, 560]
    },
    {
      "parameters": {},
      "id": "8642f493-90b7-4184-93e2-ca4eba040416",
      "name": "Concluido",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [-1568, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://flow.grupocoletivo.com.br/api/internal/publish/{{ $json.id }}",
