      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "A cada 5min": { "main": [[{ "node": "Busca fila (lock)", "type": "main", "index": 0 }]] },
    "Busca fila (lock)": { "main": [[{ "node": "Tem post?", "type": "main", "index": 0 }]] },
    "Tem post?": { "main": [[{ "node": "Loop posts", "type": "main", "index": 0 }]] },
    "Loop posts": {
      "main": [
        [{ "node": "Concluido", "type": "main", "index": 0 }],
        [{ "node": "Publica", "type": "main", "index": 0 }]
